<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>thermal-eye-sensors</AssemblyName>
    <RootNamespace>ThermalEye.Sensors</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>../assets/icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Thermal Eye</Product>
    <AssemblyTitle>Thermal Eye sensors</AssemblyTitle>
    <Copyright>Copyright (c) 2026 Dominique Bastenie</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- The default budget follows L3 size, which costs ~100 MB on X3D parts. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0Size" Value="4194304" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
